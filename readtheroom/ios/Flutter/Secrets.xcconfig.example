// Copy to Secrets.xcconfig (git-ignored). Debug.xcconfig and Release.xcconfig
// include it optionally, and Info.plist exposes these to native code.
//
// xcconfig treats `//` as the start of a comment, so URLs must be written
// with the `$()` escape between the slashes: https:/$()/example.com

SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-or-publishable-key
POSTHOG_API_KEY =
POSTHOG_HOST = https:/$()/us.i.posthog.com
