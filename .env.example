# Build-time configuration. Copy to `.env` (git-ignored) and fill in your OWN
# projects — the app has no compiled-in defaults and refuses to start without
# the two Supabase values.
#
#   cd readtheroom
#   flutter run --dart-define-from-file=../.env
#
# iOS native code (widgets, background fetch) reads the same values from
# readtheroom/ios/Flutter/Secrets.xcconfig — see Secrets.xcconfig.example.

# Supabase: Project Settings → API. Use the public anon / publishable key only.
# Never put a service-role or secret key in a client build.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# PostHog (optional — analytics is disabled when the key is empty).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
